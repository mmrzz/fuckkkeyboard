{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Layout Fixer",
  "version": "0.1.0",
  "identifier": "io.layoutfixer.desktop",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Layout Fixer",
        "width": 780,
        "height": 700,
        "minWidth": 560,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Layout Fixer",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Fixes text typed in the wrong keyboard layout",
    "longDescription": "Type in the wrong keyboard layout, then type the trigger: Layout Fixer replaces the text with what you meant and switches the layout. Runs in the tray. Typed text stays in memory and is never saved or sent anywhere.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
